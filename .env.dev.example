# Dev Environment File
# ============================================
# THIS FILE IS AUTO-GENERATED by scripts/dev-connect.sh
# DO NOT commit .env.dev to version control — it is gitignored.
# This example documents the shape of the generated file.
# ============================================
#
# Run `npm run dev:connect` (or `scripts/dev-connect.sh`) to:
#   1. Fetch dev credentials from AWS Secrets Manager
#   2. Write .env.dev with the values below
#   3. Start Next.js pointed at the dev cloud environment
#   4. Delete .env.dev automatically when the session ends
#
# WARNING: You are connecting to the SHARED development database.
# Any data you write will be visible to other developers.

# ============================================
# RUNTIME ENVIRONMENT
# ============================================
RUNTIME_ENV=development

# ============================================
# DATABASE (dev RDS — fetched from Secrets Manager)
# ============================================
DATABASE_HOST=dev-db.<id>.<region>.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=college_athlete_base
DATABASE_USER=postgres
DATABASE_PASSWORD=<fetched-from-secrets-manager>
DATABASE_SSL=true

# ============================================
# REDIS (dev ElastiCache — fetched from Secrets Manager)
# ============================================
REDIS_URL=redis://dev-cache.<id>.<region>.cache.amazonaws.com:6379

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=<fetched-from-secrets-manager>
JWT_EXPIRATION=7d

# ============================================
# LAMBDA URLS (fetched from CDK stack outputs)
# ============================================
AUTH_LAMBDA_URL=https://<api-gw-id>.execute-api.<region>.amazonaws.com/dev
PAYMENT_LAMBDA_URL=https://<api-gw-id>.execute-api.<region>.amazonaws.com/dev

# ============================================
# STRIPE (test mode keys — fetched from Secrets Manager)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_test_...
STRIPE_ANNUAL_PRICE_ID=price_test_...

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug
