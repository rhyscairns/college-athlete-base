{
  "name": "college-athlete-base",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:full": "./scripts/dev.sh",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "docker:build": "docker build -t college-athlete-base .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:local:start": "docker-compose up -d db",
    "db:local:stop": "docker-compose stop db",
    "db:local:reset": "docker-compose down -v && docker-compose up -d db",
    "db:local:logs": "docker-compose logs -f db",
    "db:local:psql": "docker-compose exec db psql -U postgres -d college_athlete_base",
    "db:migrate:local": "./scripts/db-migrate-local.sh",
    "db:seed:local": "./infrastructure/database/seeds/seed.sh local",
    "db:reset:local": "npm run db:local:reset && echo \"Database reset. Run migrations and seeds when available.\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "^15.1.6",
    "pg": "^8.16.3",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "2.15.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.6",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-sonarjs": "^0.25.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^15.1.6",
    "@next/swc-darwin-x64": "^15.1.6",
    "@next/swc-linux-x64-gnu": "^15.1.6",
    "@next/swc-linux-x64-musl": "^15.1.6",
    "@next/swc-win32-x64-msvc": "^15.1.6"
  }
}