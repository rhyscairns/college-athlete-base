{
  "extends": [
    "next/core-web-vitals"
  ],
  "plugins": [
    "sonarjs"
  ],
  "rules": {
    // Code Quality Rules
    "sonarjs/cognitive-complexity": [
      "warn",
      15
    ],
    "sonarjs/no-duplicate-string": [
      "warn",
      {
        "threshold": 3
      }
    ],
    "sonarjs/no-identical-functions": "warn",
    "sonarjs/no-collapsible-if": "warn",
    "sonarjs/prefer-immediate-return": "warn",
    "sonarjs/prefer-object-literal": "warn",
    "sonarjs/prefer-single-boolean-return": "warn",
    // Complexity Rules
    "complexity": [
      "warn",
      15
    ],
    "max-depth": [
      "warn",
      4
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 100,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": [
      "warn",
      5
    ],
    // Best Practices
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ],
    "no-debugger": "error",
    "no-alert": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**/*",
        "**/__mocks__/**/*",
        "**/e2e/**/*"
      ],
      "rules": {
        // Relax rules for test files
        "sonarjs/cognitive-complexity": "off",
        "sonarjs/no-duplicate-string": "off",
        "sonarjs/no-identical-functions": "off",
        "complexity": "off",
        "max-depth": "off",
        "max-lines-per-function": "off",
        "max-params": "off",
        "prefer-const": "off",
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/profile/player/utils/validation.ts",
        "**/profile/player/utils/profile-helpers.ts",
        "**/profile/player/components/view-page/HeroSection.tsx",
        "**/profile/player/components/view-page/RecruitingContactSection.tsx",
        "**/profile/player/components/view-page/StatsShowcase.tsx",
        "**/profile/player/components/view-page/PlayerProfileView.tsx",
        "**/profile/player/components/view-page/AcademicProfileSection.tsx",
        "**/profile/player/components/view-page/AthleticAchievementsSection.tsx",
        "**/profile/player/components/view-page/CoachesPerspectiveSection.tsx",
        "**/profile/player/components/view-page/GameHighlightsSection.tsx",
        "**/profile/player/components/edit/components/sections/StatsShowcaseEdit.tsx",
        "**/authentication/components/CoachRegistrationForm.tsx",
        "**/app/api/auth/login/player/route.ts",
        "**/app/api/auth/register/coach/route.ts",
        "**/app/api/auth/register/player/route.ts",
        "**/app/api/coach/[coachId]/profile/route.ts",
        "**/app/api/dashboard/players/route.ts",
        "**/profile/player/components/view-page/data.mock.ts",
        "**/profile/player/data/mockPlayerData.ts"
      ],
      "rules": {
        // Relax complexity rules for complex UI components, API routes, and validation logic
        "sonarjs/cognitive-complexity": "off",
        "sonarjs/no-collapsible-if": "off",
        "sonarjs/no-duplicate-string": "off",
        "complexity": "off",
        "max-lines-per-function": "off"
      }
    }
  ]
}