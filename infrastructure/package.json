{
  "name": "college-athlete-base-infrastructure",
  "version": "1.0.0",
  "description": "Infrastructure as Code for College Athlete Base platform",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "cdk deploy DevStack --require-approval never",
    "deploy:prod": "cdk deploy ProdStack --require-approval always",
    "diff:dev": "cdk diff DevStack",
    "diff:prod": "cdk diff ProdStack",
    "synth": "cdk synth",
    "destroy:dev": "cdk destroy DevStack",
    "destroy:prod": "cdk destroy ProdStack",
    "test": "jest --runInBand",
    "test:update-snapshots": "jest --updateSnapshot --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "strict": false
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.120.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.0.0"
  }
}