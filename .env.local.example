# Local Development Environment Configuration
# Copy this file to .env.local and update values as needed.
# This file is for LOCAL development only — no AWS, Lambda, or Stripe required.

# ============================================
# RUNTIME ENVIRONMENT (local-only)
# ============================================
# Keep this as 'local' for local development.
# The app will use the local DB directly and show the payment simulation button.
RUNTIME_ENV=local

# ============================================
# DATABASE CONFIGURATION (Local Docker)
# ============================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=college_athlete_base
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Connection Pool Configuration
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=2000
DATABASE_STATEMENT_TIMEOUT=10000

# Alternative: full connection string
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_athlete_base

# ============================================
# REDIS (Local Docker)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# AUTHENTICATION & SECURITY (local-only)
# ============================================
BCRYPT_ROUNDS=10
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# LAMBDA URLS — not used when RUNTIME_ENV=local
# ============================================
# These are only needed when connecting to cloud environments.
# Leave blank for local development.
# AUTH_LAMBDA_URL=
# PAYMENT_LAMBDA_URL=

# ============================================
# STRIPE — not used when RUNTIME_ENV=local
# ============================================
# Stripe is bypassed locally. The payment simulation button sets
# isCABMember=true directly in the local DB without contacting Stripe.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_MONTHLY_PRICE_ID=
# STRIPE_ANNUAL_PRICE_ID=
